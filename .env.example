# Empty DATABASE_URL selects the local SQLite demo.
DATABASE_URL=
POSTFLOW_SQLITE_PATH=backend/data/postflow.db

# Only needed for optional cloud OCR. Supply your own key and model identifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ESP32 must be reachable on your local network.
ESP32_URL=http://esp32-buudien.local/distance
